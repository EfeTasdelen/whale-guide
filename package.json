    "ranges": "node tools/build_ranges.js"
  },
  "devDependencies": {
    "http-server": "14.1.1",
    "polygon-clipping": "0.15.7",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  }
}
