{
  "name": "whale-guide",
  "version": "0.3.0",
  "private": true,
  "description": "Whale Guide: static site, no build step. npm start serves it on http://localhost:5500",
  "scripts": {
    "start": "npx --yes http-server -p 5500 -c-1 -o",
